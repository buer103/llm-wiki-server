LLM_WIKI_APP_ENV=dev
LLM_WIKI_APP_HOST=0.0.0.0
LLM_WIKI_APP_PORT=8080
LLM_WIKI_LOG_LEVEL=INFO
LLM_WIKI_API_PREFIX=/v1/llm-wiki-server

# MySQL
LLM_WIKI_MYSQL_DSN=mysql+pymysql://llm_wiki:llm_wiki@localhost:3306/llm_wiki
LLM_WIKI_MYSQL_POOL_SIZE=5
LLM_WIKI_MYSQL_MAX_OVERFLOW=10

# Redis
LLM_WIKI_REDIS_URL=redis://localhost:6379/0

# Elasticsearch
LLM_WIKI_ELASTICSEARCH_URL=http://localhost:9200

# Kafka
LLM_WIKI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LLM_WIKI_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
LLM_WIKI_KAFKA_SASL_MECHANISM=
LLM_WIKI_KAFKA_SASL_USERNAME=
LLM_WIKI_KAFKA_SASL_PASSWORD=

# OBS
LLM_WIKI_OBS_ENDPOINT=
LLM_WIKI_OBS_BUCKET=
LLM_WIKI_OBS_ACCESS_KEY=
LLM_WIKI_OBS_SECRET_KEY=

# LiteLLM gateway
LLM_WIKI_LITELLM_BASE_URL=
LLM_WIKI_LITELLM_API_KEY=

# VIAM
LLM_WIKI_VIAM_BASE_URL=

LLM_WIKI_VIAM_TIMEOUT_SECONDS=5
LLM_WIKI_INFRASTRUCTURE_CHECK_TIMEOUT_SECONDS=3
